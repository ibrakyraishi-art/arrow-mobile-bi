# Скопируйте этот файл в .env.local (для локального запуска) и заполните.
# В продакшене те же переменные задаются в Vercel → Settings → Environment Variables.
# Реальные значения НИКОГДА не коммитьте в git.

# --- Supabase (Project Settings → API) ---
# URL проекта, вида https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Публичный anon / publishable ключ (его можно отдавать в браузер, защита — через RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Секретный service_role ключ. Только сервер, БЕЗ префикса NEXT_PUBLIC_.
# Нужен для cron-уведомлений, админки (список/удаление пользователей), скриншотов обратной связи.
SUPABASE_SERVICE_ROLE_KEY=

# --- Шифрование секретов в БД (пароли ClickHouse, API-ключи LLM, токены Telegram) ---
# Ровно 64 hex-символа (32 байта). Сгенерировать: openssl rand -hex 32
# ВАЖНО: после запуска не меняйте — уже зашифрованные данные перестанут расшифровываться.
ENCRYPTION_KEY=

# --- Cron (Vercel Cron → /api/cron/alert-rules) ---
# Любая длинная случайная строка. Сгенерировать: openssl rand -hex 32
CRON_SECRET=

# --- Администратор сервиса ---
# Email пользователя, которому доступна вкладка «Админка».
# Тот же email нужно указать в SQL-функции public.is_admin() (см. README).
ADMIN_EMAIL=
